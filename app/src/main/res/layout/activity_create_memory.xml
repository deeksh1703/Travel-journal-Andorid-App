<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/screenn_bg"
    tools:context=".CreateMemoryActivity">

    <!-- Central rounded card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="18dp"
        app:cardUseCompatPadding="true"
        app:strokeWidth="0dp"
        app:layout_constraintWidth_percent="0.92"
        app:layout_constraintHeight_percent="0.85"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:foregroundTintMode="src_over"
        android:backgroundTint="@android:color/white">

        <!-- Inner content -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="22dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="New Adventure"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/titlle_text"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Photos label -->
            <TextView
                android:id="@+id/tvPhotosLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Photos"
                android:textStyle="bold"
                android:textColor="@color/label_text"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="18dp"/>

            <!-- Add photos button (small pill) -->
            <Button
                android:id="@+id/btnAddPhotos"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Add Photos"
                android:textAllCaps="false"
                android:drawablePadding="8dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:background="@drawable/add_photos_pill"
                android:textColor="@color/primary_500"
                android:textSize="13sp"
                app:layout_constraintBaseline_toBaselineOf="@id/tvPhotosLabel"
                app:layout_constraintEnd_toEndOf="parent"/>
<!--                android:drawableLeft="@drawable/ic_camera"/> &lt;!&ndash; optional camera icon &ndash;&gt;-->


            <!-- Recycler horizontal images -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvImagePreview"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:clipToPadding="false"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:overScrollMode="never"
                app:layout_constraintTop_toBottomOf="@id/tvPhotosLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"/>

            <!-- Date label -->
            <TextView
                android:id="@+id/tvDateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date"
                android:textStyle="bold"
                android:textColor="@color/label_text"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/rvImagePreview"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="10dp"/>

            <!-- Date pill -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Oct 26, 2024"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:background="@drawable/date_pill"
                android:textColor="@color/primary_700"
                app:layout_constraintBaseline_toBaselineOf="@id/tvDateLabel"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Description label -->
            <TextView
                android:id="@+id/tvDescLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textStyle="bold"
                android:textColor="@color/label_text"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/tvDateLabel"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="12dp"/>

            <!-- Description box -->
            <EditText
                android:id="@+id/etDescription"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:hint="Write about your journey..."
                android:inputType="textMultiLine"
                android:gravity="top"
                android:background="@drawable/desc_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="@color/fieldd_text"
                app:layout_constraintTop_toBottomOf="@id/tvDescLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"/>

            <!-- Save Button (bottom) -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="Save Memory"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="@android:color/white"
                android:background="@drawable/button_gradient"
                android:elevation="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="12dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
