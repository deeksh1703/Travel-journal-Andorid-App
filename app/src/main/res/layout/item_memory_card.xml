<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="6dp"
    app:cardUseCompatPadding="true"
    android:foreground="?attr/selectableItemBackground"
    android:backgroundTint="@android:color/white"
    android:padding="14dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Date -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="2024-10-26"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/tile_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/groupIcons"
            app:layout_constraintHorizontal_bias="0"/>

        <!-- Edit/Delete icon group -->
        <LinearLayout
            android:id="@+id/groupIcons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="@id/tvDate"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="49dp"
                android:layout_height="51dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/icon_circle"
                android:contentDescription="@string/edit"
                android:padding="6dp"
                android:src="@drawable/ic_camera" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="56dp"
                android:layout_height="61dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/icon_circle"
                android:contentDescription="@string/delete"
                android:padding="6dp"
                android:src="@drawable/ic_delete" />
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Sunset at the beach in Bali"
            android:textColor="@color/labl_text"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tvDate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp"/>

        <!-- Thumbnails horizontal: use a small RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvThumbs"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_marginTop="10dp"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/tvDesc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
