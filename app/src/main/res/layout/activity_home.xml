<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_watercolor_gradient"
    tools:context=".MainActivity">

    <!-- White Card Container -->
    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_white_card"
        android:elevation="6dp">

        <!-- Top Row: Title and Logout -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Adventure"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#000000"
                android:layout_alignParentStart="true"/>

            <Button
                android:id="@+id/tvLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:drawableEnd="@android:drawable/ic_lock_power_off"
                android:drawablePadding="4dp"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>

        <!-- Center Illustration and Greeting -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/ic_travel_globe"
                android:contentDescription="Globe Illustration"
                android:layout_gravity="center"/>

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello, User!"
                android:textStyle="bold"
                android:textSize="24sp"
                android:textColor="#000000"
                android:layout_marginTop="16dp"/>
        </LinearLayout>

        <!-- Buttons -->
        <Button
            android:id="@+id/btnCreateMemory"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Create Memory"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_gradient_purple"
            android:drawableStart="@android:drawable/ic_input_add"
            android:drawablePadding="10dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnViewMemories"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="View Memories"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_gradient_green"
            android:drawableStart="@android:drawable/ic_menu_agenda"
            android:drawablePadding="10dp" />
    </LinearLayout>

</RelativeLayout>